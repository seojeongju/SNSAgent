{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snsagent",
  // Pages: 정적 산출물 디렉터리
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snsagent-db",
      // wrangler d1 create snsagent-db 후 ID 교체
      "database_id": "4fb0ea2a-2046-418a-b63d-5d6cc2edbd87",
      // pages local dev 에 필요
      "preview_database_id": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "snsagent-assets",
      "preview_bucket_name": "snsagent-assets"
    }
  ]
  // Dashboard > Settings > Bindings / Variables 에서도 동일하게 설정 가능
  // Secrets: OPENAI_API_KEY, META_APP_ID, META_APP_SECRET, META_ACCESS_TOKEN,
  //          META_IG_USER_ID, META_PAGE_ID, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  //          TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET, *_REDIRECT_URI
}
